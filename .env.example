# Copy this file to .env and fill in real values there.
# .env is gitignored - never commit real secrets.

CLINIC_NAME=CliniKit Clinic
CLINIC_OPENING_HOURS=Monday to Friday, 8:00 AM to 6:00 PM. We're closed on weekends.

# Structured version of the hours above (24-hour clock) - used to actually
# reject a booking outside these hours or on a closed day.
CLINIC_OPEN_HOUR=8
CLINIC_CLOSE_HOUR=18
CLINIC_CLOSED_WEEKDAYS=saturday,sunday

# Where the (mocked) patient directory and appointment book are stored.
PATIENT_STORE_PATH=patients.json
APPOINTMENT_STORE_PATH=appointments.json

# The clinic's doctors, comma-separated.
CLINIC_DOCTORS=Dr. George,Dr. Karim,Dr. Reed,Dr. Han,Dr. Lee

# Placeholder for a real clinic/EHR API integration - not used by the mocked
# actions yet.
CLINIC_API_KEY=

# Login for the admin board (admin_board.py). Change these - the defaults
# are meant to be replaced, not used as-is.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
